# ==============================================================================
# VoiceOps Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Environment
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME=VoiceOps
APP_URL=http://localhost:3000
API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Key for encrypting third-party tokens (e.g. GitHub OAuth tokens) at rest
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=QZNoMijl7DfEoGT67yFY6OFxtouxMUB4rfoLNLZO5zk=

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# PostgreSQL & pgvector Database (Local Docker or Supabase)
# ------------------------------------------------------------------------------
POSTGRES_USER=voiceops
POSTGRES_PASSWORD=voiceops_secure_password
POSTGRES_DB=voiceops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Option A: Local Docker PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://voiceops:voiceops_secure_password@localhost:5432/voiceops_db
# For Docker Compose internal networking:
# DATABASE_URL=postgresql+asyncpg://voiceops:voiceops_secure_password@postgres:5432/voiceops_db

# Option B: Supabase Managed PostgreSQL + pgvector
# Get this from your Supabase Project Settings -> Database -> Connection string (URI)
# Format: postgresql+asyncpg://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?ssl=require
# Or Direct: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?ssl=require
# DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?ssl=require

# Supabase API Credentials (Optional, for client SDKs)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Option C: Zero-dependency SQLite Fallback (for rapid local testing without Postgres)
# USE_SQLITE_FALLBACK=True

# ------------------------------------------------------------------------------
# Redis & Background Tasks
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
# For Docker Compose internal networking:
# REDIS_URL=redis://redis:6379/0

# ------------------------------------------------------------------------------
# AI / LLM Providers
# ------------------------------------------------------------------------------
# Supported: openai | gemini | anthropic
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# Voice AI (STT & TTS)
# ------------------------------------------------------------------------------
# STT Provider: deepgram | openai | browser_native
STT_PROVIDER=openai
DEEPGRAM_API_KEY=

# TTS Provider: elevenlabs | openai | browser_native
TTS_PROVIDER=openai
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ------------------------------------------------------------------------------
# GitHub Integration (OAuth App)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/auth/callback/github
GITHUB_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Document Storage & RAG
# ------------------------------------------------------------------------------
DOCUMENT_UPLOAD_DIR=./uploads
MAX_DOCUMENT_SIZE_MB=25
EMBEDDING_DIMENSION=1536
RAG_SIMILARITY_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# Rate Limiting & Safety
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE_AUTH=10
RATE_LIMIT_PER_MINUTE_AGENT=30
RATE_LIMIT_PER_MINUTE_VOICE=60
APPROVAL_TOKEN_EXPIRE_MINUTES=15
