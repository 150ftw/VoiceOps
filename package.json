{
  "name": "voiceops-monorepo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix apps/web run dev",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web start",
    "lint": "npm --prefix apps/web run lint",
    "test:backend": "cd apps/api && PYTHONPATH=. .venv/bin/pytest -v"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
